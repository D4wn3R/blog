# ============================================================================
# 博客后端环境变量模板
# 用法：cp .env.example .env 后按需填写；.env 已被 .gitignore 忽略，禁止提交
# 加载规则：程序启动时自动读取工作目录下的 .env（无此文件则跳过）
# 优先级：真实环境变量 > .env > configs/config.yaml
# 键名规则：BLOG_ 前缀 + 配置路径大写下划线（oauth.github.client_id → BLOG_OAUTH_GITHUB_CLIENT_ID）
# ============================================================================

# ---- 服务器 ----
BLOG_SERVER_PORT=8080
BLOG_SERVER_MODE=debug            # debug / release（release 强制要求强 JWT secret）

# ---- MySQL ----
BLOG_MYSQL_DSN=

# ---- Redis ----
BLOG_REDIS_ADDR=
BLOG_REDIS_PASSWORD=
BLOG_REDIS_DB=

# ---- RustFS（对象存储）----
BLOG_RUSTFS_ENDPOINT=
BLOG_RUSTFS_ACCESS_KEY=
BLOG_RUSTFS_SECRET_KEY=
BLOG_RUSTFS_USE_SSL=
BLOG_RUSTFS_BUCKET=

# ---- JWT ----
# 生产（release）必须 ≥32 位强随机 secret，否则启动拒绝
BLOG_JWT_SECRET=
# 以下 TTL 有 config.yaml 默认值，按需取消注释覆盖
# BLOG_JWT_ACCESS_EXPIRE=30m
# BLOG_JWT_REFRESH_EXPIRE=720h
# BLOG_JWT_UNLOCK_EXPIRE=10m

# ---- OAuth ----
# 前端地址，callback 处理完 302 跳转用
BLOG_OAUTH_BASE_URL=
# GitHub OAuth App：https://github.com/settings/developers
BLOG_OAUTH_GITHUB_CLIENT_ID=
BLOG_OAUTH_GITHUB_CLIENT_SECRET=
# redirect_url 必须与 GitHub App 后台注册的 Callback URL 完全一致，否则授权时报 redirect_uri_mismatch
BLOG_OAUTH_GITHUB_REDIRECT_URL=
# github.com 候选连接 IP（逗号分隔，最多取前 2 个）：优先按列表轮换拨号，
# 列表用尽后自动回退系统 DNS，单个 IP 失效不会让登录整体不可用。
# 若所在网络对 github.com 的 DNS 解析/直连不稳，可先用 nslookup 查出可达 IP 填入；
# 换 IP 前先验证：curl --resolve github.com:443:<IP> https://github.com/
#BLOG_OAUTH_GITHUB_IPS=

# ---- 管理员初始化（-migrate 时 seed，spec §8）----
# GitHub：填数字用户 ID（curl https://api.github.com/users/<你的用户名> 取 id 字段），
# 迁移时预建 admin 用户 + GitHub 绑定，此后 GitHub 登录直接以 admin 身份进入
BLOG_ADMIN_GITHUB_ID=

# ---- CORS ----
# cors.allowed_origins 为数组，环境变量覆盖不便，请直接改 configs/config.yaml
