# ============================================================================
# 博客后端环境变量模板 —— 只放敏感信息
#
# 分层原则：
#   - 本文件：敏感信息（密码 / 密钥 / client_secret / 账号标识）
#   - configs/config.yaml：非敏感配置（端口、模式、超时、开关、公开 URL、CORS 白名单）
#
# 用法：cp .env.example .env 后填入真实值；.env 已被 .gitignore 忽略，禁止提交。
# 加载：程序启动时自动读取工作目录下的 .env（无此文件则跳过）。
# 优先级：真实环境变量 > .env > configs/config.yaml > 代码内默认值。
#
# 键名规则：BLOG_ 前缀 + 配置路径大写下划线
#   oauth.github.client_secret → BLOG_OAUTH_GITHUB_CLIENT_SECRET
#
# 想改端口 / 运行模式 / 追踪开关这类非敏感项，请改 configs/config.yaml，
# 不要在这里加。
# ============================================================================

# ---- 数据库（DSN 含 root 密码，故整体走环境变量）----
# 格式：<user>:<password>@tcp(<host>:<port>)/<db>?charset=utf8mb4&parseTime=True&loc=Asia%2FShanghai
BLOG_MYSQL_DSN=

# ---- Redis 密码 ----
BLOG_REDIS_PASSWORD=

# ---- RustFS（对象存储）凭证 ----
BLOG_RUSTFS_ACCESS_KEY=
BLOG_RUSTFS_SECRET_KEY=

# ---- JWT 签名密钥 ----
# release 模式强制要求 ≥32 位强随机值，否则启动即拒绝
# 生成：openssl rand -hex 32
BLOG_JWT_SECRET=

# ---- GitHub OAuth App 凭证 ----
# 创建/查看：https://github.com/settings/developers
BLOG_OAUTH_GITHUB_CLIENT_ID=
BLOG_OAUTH_GITHUB_CLIENT_SECRET=

# ---- 管理员初始化（-migrate 时 seed，spec §8）----
# GitHub 数字用户 ID（非用户名，改名不失效）：
#   curl https://api.github.com/users/<你的用户名> 取 id 字段
# 迁移时预建 admin 用户 + GitHub 绑定，此后 GitHub 登录直接以 admin 身份进入
BLOG_ADMIN_GITHUB_ID=

# ============================================================================
# 以下为非敏感项的临时覆盖（正常应改 configs/config.yaml，此处仅用于
# 同一份代码跑多套环境时临时切换；留空即用 yaml 的值）
# ============================================================================

# 监听端口（yaml: server.port）
#BLOG_SERVER_PORT=8080
# gin 运行模式 debug/release（yaml: server.mode）
#BLOG_SERVER_MODE=debug

# Redis 地址与库号（yaml: redis.addr / redis.db）
#BLOG_REDIS_ADDR=127.0.0.1:6379
#BLOG_REDIS_DB=0

# RustFS 端点与桶（yaml: rustfs.endpoint / rustfs.bucket）
#BLOG_RUSTFS_ENDPOINT=127.0.0.1:9000
#BLOG_RUSTFS_BUCKET=blog
#BLOG_RUSTFS_USE_SSL=false

# OAuth 回调基地址与 GitHub 回调地址（yaml: oauth.base_url / oauth.github.redirect_url）
#BLOG_OAUTH_BASE_URL=http://localhost:5173
#BLOG_OAUTH_GITHUB_REDIRECT_URL=http://127.0.0.1:8080/api/oauth/github/callback

# github.com 候选连接 IP（逗号分隔，最多取前 2 个）：优先按列表轮换拨号，
# 列表用尽后自动回退系统 DNS，单个 IP 失效不会让登录整体不可用。
# 若所在网络对 github.com 的 DNS 解析/直连不稳，可先用 nslookup 查出可达 IP 填入；
# 换 IP 前先验证：curl --resolve github.com:443:<IP> https://github.com/
#BLOG_OAUTH_GITHUB_IPS=

# JWT 有效期（yaml 已有默认值，按需覆盖）
#BLOG_JWT_ACCESS_EXPIRE=30m
#BLOG_JWT_REFRESH_EXPIRE=720h
#BLOG_JWT_UNLOCK_EXPIRE=10m

# 链路追踪开关与端点（yaml: tracing.*）
#BLOG_TRACING_ENABLED=false
#BLOG_TRACING_ENDPOINT=127.0.0.1:4317
#BLOG_TRACING_INSECURE=true
#BLOG_TRACING_SAMPLE_RATIO=1
#BLOG_TRACING_SERVICE_NAME=blog-backend
#BLOG_TRACING_ENVIRONMENT=release

# 指标开关（yaml: metrics.enabled）
#BLOG_METRICS_ENABLED=false
