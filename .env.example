# ============================================================================
# 中间件容器环境变量模板（docker compose 的变量展开源）
#
# 职责：只放 compose 需要的敏感凭证，以及容器侧的部署形态覆盖。
# 应用自身的非敏感配置在 backend/configs/config.yaml，应用敏感项在 backend/.env。
#
# 用法：cp .env.example .env 后生成强密码填入（openssl rand -hex 16）
# ⚠️ 密码变更后须同步修改 backend/.env 的 BLOG_MYSQL_DSN 与
#    BLOG_RUSTFS_ACCESS_KEY / BLOG_RUSTFS_SECRET_KEY（应用侧连接凭证）
# ============================================================================

# ---- 敏感：中间件凭证 ----

# MySQL root 密码与业务库名（库名非敏感，放这里是因为 compose 要用它建库）
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=blog

# Redis 访问密码
REDIS_PASSWORD=

# RustFS 控制台账号与密码（密码至少 8 位）
RUSTFS_ROOT_USER=blogrustfs
RUSTFS_ROOT_PASSWORD=

# ============================================================================
# 以下为容器侧部署形态覆盖（缺省即本地形态，生产在服务器 .env 覆盖）
# 这些是 compose 注入给容器的变量，不是应用配置文件本身
# ============================================================================

# gin 运行模式：release 会强校验 JWT secret ≥32 位（配合 backend/.env 的强 secret）
#BLOG_SERVER_MODE=release

# OAuth 回调基地址（本地缺省 http://localhost；前端 dev 5173 时后端直连即可）
#BLOG_OAUTH_BASE_URL=https://your-domain.example
#BLOG_OAUTH_GITHUB_REDIRECT_URL=https://your-domain.example/api/oauth/github/callback
# github.com 候选连接 IP（逗号分隔）：生产按需填写，本地留空走系统 DNS
#BLOG_OAUTH_GITHUB_IPS=

# 前端容器对外绑定（本地默认 127.0.0.1:8081，避免占用 80）
#FRONTEND_BIND=127.0.0.1
#FRONTEND_PORT=8081
