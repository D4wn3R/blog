# ============================================================================
# 中间件容器变量模板（docker compose 变量展开源）
# 用法：cp .env.example .env 后生成强密码填入（openssl rand -hex 16）
# ⚠️ 密码变更后须同步修改 backend/.env 的 BLOG_MYSQL_DSN 与
#    BLOG_RUSTFS_ACCESS_KEY / BLOG_RUSTFS_SECRET_KEY（应用侧连接凭证）
# ============================================================================

# MySQL root 密码与业务库名
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=blog

# Redis 访问密码
REDIS_PASSWORD=

# RustFS 控制台账号与密码（密码至少 8 位）
RUSTFS_ROOT_USER=blogrustfs
RUSTFS_ROOT_PASSWORD=

# ============================================================================
# 以下为部署形态变量（缺省即本地形态，生产按需覆盖）
# ============================================================================

# release 模式强校验 JWT secret ≥32 位（配合 backend/.env 的强 secret）
#BLOG_SERVER_MODE=release

# OAuth 回调基地址（本地形态缺省 http://localhost，前端 dev 为 5173 时后端直连即可）
#BLOG_OAUTH_BASE_URL=https://your-domain.example
#BLOG_OAUTH_GITHUB_REDIRECT_URL=https://your-domain.example/api/oauth/github/callback
